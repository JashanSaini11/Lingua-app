# Shared with the Expo app: put these in the parent ../.env
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret
# Free: get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key
# Only if LLM_PROVIDER=openai (paid)
OPENAI_API_KEY=your_openai_api_key

# Which realtime LLM to use: gemini (default, free tier) or openai
LLM_PROVIDER=gemini

# Language the teacher SPEAKS to the learner (default: English).
# The language being taught always comes from the lesson the learner opened.
TEACHER_LANGUAGE=English

# Cost and safety limits (defaults shown)
# Longest a single lesson call can run, in minutes
MAX_SESSION_MINUTES=15
# How many lessons can run at the same time
MAX_CONCURRENT_SESSIONS=5

# Shared secret between the Expo server and this agent server. Put the SAME value
# in the parent ../.env as AGENT_API_SECRET. Leave empty for local development only.
AGENT_API_SECRET=

# Optional: use one Gemini voice for every teacher instead of one voice per teacher
# GEMINI_VOICE=Aoede
